<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-6 mx-auto mt-3 shadow-sm" role="alert">
    <strong><i class="bi bi-check-circle-fill"></i></strong> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
