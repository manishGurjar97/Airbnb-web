<% if (success && success.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show col-6 mx-auto mt-3 shadow-sm" role="alert">
    <strong><i class="bi bi-check-circle-fill"></i></strong> <%= success[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

