<% layout('/layouts/boilerplate') -%>


    <body>
       <!-- FULL WIDTH RESPONSIVE FILTER BAR -->
<div class="filters container-fluid mt-2">
  <div id="filter" class="d-flex flex-wrap justify-content-center">

    <a href="/listing/trending?sort=trending" class="filter-chip">
    <i class="fa-solid fa-fire"></i> Trending
</a>

    <a href="/listing?sort=toprated" class="filter-chip">
      <i class="fa-solid fa-fire"></i> Top Rated
    </a>

    <a href="/listing?sort=new" class="filter-chip">
      <i class="fa-solid fa-fire"></i> New
    </a>

    <a href="/listing?category=mountains" class="filter-chip">
      <i class="fa-solid fa-snowflake"></i> Mountains
    </a>

    <a href="/listing?category=city" class="filter-chip">
      <i class="fa-solid fa-city"></i> City
    </a>

    <a href="/listing?category=village" class="filter-chip">
      <i class="fa-solid fa-warehouse"></i> Village
    </a>

  </div>
</div>


        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for (let list of listing) { %>
    <a href="/listing/<%= list._id  %>" class="card card-link-wrapper">
      <img src="<%= list.image.url %>" class="card-img-top" alt="Hotel image">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
          <%= list.title %> <br>
          <tag>&#8377</tag>
          <%= list.price %>
        </p>
      </div>
    </a>
  <% } %>
</div>



    </body>