<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">

                    <div class="card shadow-sm border-0 rounded-4">
                        <img src="<%= listdata.image.url %>" class="card-img-top rounded-top" alt="Listing Image">

                        <div class="card-body">

                            <h5 class="card-title fw-semibold text-primary">
                                👤 Owned by <span class="text-dark">
                                    <%= listdata.owner.username %>
                                </span>
                            </h5>

                            <h4 class="fw-bold mt-3">
                                <%= listdata.title %>
                            </h4>

                            <p class="text-muted">
                                <%= listdata.description %>
                            </p>

                            <p><strong>Price:</strong> ₹<%= listdata.price.toLocaleString("en-IN") %>
                            </p>
                            <p><strong>Location:</strong>
                                <%= listdata.location %>
                            </p>
                            <p><strong>Country:</strong>
                                <%= listdata.country %>
                            </p>

                            <!-- Owner Buttons -->
                            <% if(currentUser && currentUser._id.equals(listdata.owner._id)){ %>
                                <div class="row mb-4">
                                    <div class="col-6">
                                        <a href="/listing/<%= listdata._id %>/edit" class="btn btn-primary w-100">Edit
                                            Listing</a>
                                    </div>
                                    <div class="col-6">
                                        <form action="/listing/<%= listdata._id %>?_method=DELETE" method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this listing?')">
                                            <button type="submit" class="btn btn-danger w-100">Delete</button>
                                        </form>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Review Form -->
                                    <div class="mb-4">
                                        <% if (currentUser) { %>
                                            <h4 class="mb-3">Drop your great review here ✨</h4>

                                            <form action="/listing/<%= listdata._id %>/review" method="POST">

                                                <!-- ⭐ Rating -->
                                                <span class="form-label">Rating:</span>
                                                <div class="d-flex justify-content-center">


                                                    <fieldset class="starability-slot mb-3">


                                                        <input type="radio" id="rate1" name="review[rating]" value="1">
                                                        <label for="rate1">1 star</label>

                                                        <input type="radio" id="rate2" name="review[rating]" value="2">
                                                        <label for="rate2">2 stars</label>

                                                        <input type="radio" id="rate3" name="review[rating]" value="3">
                                                        <label for="rate3">3 stars</label>

                                                        <input type="radio" id="rate4" name="review[rating]" value="4">
                                                        <label for="rate4">4 stars</label>


                                                    </fieldset>
                                                </div>

                                                <!-- Comments -->
                                                <label for="comments">Your Comments:</label>
                                                <textarea id="comments" name="review[comments]" rows="4"
                                                    class="form-control mb-3" required></textarea>

                                                <button type="submit" class="btn btn-primary w-100">Submit
                                                    Review</button>
                                            </form>

                                            <% } else { %>
                                                <div class="alert alert-warning">
                                                    <b>Please login first to add a review.</b>
                                                </div>
                                                <% } %>
                                    </div>

                                    <hr>

                                    <!-- ⭐ Review List -->
                                    <div class="mt-4">

                                        <% if (listdata.reviews.length===0) { %>
                                            <p class="text-muted">No reviews yet. Be the first to write one!</p>
                                            <% } %>

                                                <% listdata.reviews.forEach(review=> { %>
                                                    <div class="card mb-3 shadow-sm border-0">
                                                        <div class="card-body">

                                                            <h6 class="text-primary">@<%= review.author.username %>
                                                            </h6>

                                                            <!-- ⭐ Stars -->
                                                            <div class="starability-result mb-2"
                                                                data-rating="<%= review.rating %>"></div>

                                                            <p><strong>Comment:</strong>
                                                                <%= review.comments %>
                                                            </p>

                                                            <!-- Delete Button - Review Owner Only -->
                                                            <% if (currentUser && review.author.equals(currentUser._id))
                                                                { %>
                                                                <form method="POST"
                                                                    action="/listing/<%= listdata._id %>/review/<%= review._id %>?_method=DELETE">
                                                                    <button class="btn btn-danger w-100">Delete
                                                                        Review</button>
                                                                </form>
                                                                <% } %>

                                                                    <!-- Date -->
                                                                    <p class="text-muted mt-2 small">
                                                                        Reviewed on: <%= review.createdAt.toDateString()
                                                                            %>
                                                                    </p>

                                                        </div>
                                                    </div>
                                                    <% }) %>
                                                        <div class="mb-4">
                                                            <h3>where you will be </h3>
                                                            <div id="map">
                                                                </div>

                                                            

                                                            <script>
                                                                // Backend se aaya data (EJS inject)
                                                                const lat = <%= listdata.geometry.lat %>;
                                                                const lng = <%= listdata.geometry.lng %>;

                                                                // Map initialize
                                                                var map = L.map('map').setView([lat, lng], 12);

                                                                // OSM Tile Layer
                                                                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                                                    maxZoom: 19
                                                                }).addTo(map);

                                                                // Marker add
                                                                L.marker([lat, lng]).addTo(map)
                                                                    .bindPopup(`<b><%= listdata.title %></b><br><%= listdata.location %>`)
                                                                    .openPopup();
                                                            </script>



                                                        </div>

                                    </div>
                        </div>

                    </div>
                </div>
            </div>
    </body>