<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <form method="POST" action="/listing/<%= listdata._id %>?_method=PUT">
        <input type="text" value="<%= listdata.title %>" name="title"><br><br>

        <input type="text" value="<%= listdata.description %>" name="description"><br><br>

        <!-- Fixed typo: 'emage' → 'image' -->
        <input type="text" value="<%= listdata.image %>" name="image"><br><br>

        <!-- Removed space in type="number " -->
        <input type="number" value="<%= listdata.price %>" name="price"><br><br>

        <input type="text" value="<%= listdata.location %>" name="location"><br><br>

        <input type="text" value="<%= listdata.country %>" name="country"><br><br>

        <button type="submit">Update Listing</button>
    </form>
</body>
</html>
